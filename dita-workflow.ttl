# ---- v2 → v3 변경 (온톨로지 검증 결과 반영, 제안) ----
wf:vc01 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 2 ; wf:resultingStep wf:step02 ; wf:changeType "변경" ;
    wf:change "입력 '문서 작성 워크플로우 템플릿'을 '워크플로우 온톨로지(.ttl)'로 대체. 제외 단계의 출력물을 쓰는 단계 표시"@ko ;
    wf:reason "단계·입출력·전이를 기계가 읽는 형태로 제공해 제안과 검증의 기준을 하나로 통일"@ko ;
    wf:ontologyBasis "온톨로지 도입"@ko .
wf:vc02 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:resultingStep wf:step04 ; wf:changeType "신규" ;
    wf:change "워크플로우 정의 검증 단계 신규 (스크립트, SHACL 규칙 R1~R8)"@ko ;
    wf:reason "단계를 제외하거나 추가하면서 끊긴 입출력·누락된 분기를 실행 전에 검출"@ko ;
    wf:ontologyBasis "R1~R8 전체"@ko .
wf:vc03 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 5 ; wf:resultingStep wf:step06 ; wf:changeType "변경" ;
    wf:change "입력 '확정 워크플로우'를 검증을 통과한 '프로젝트 워크플로우 정의'로 변경"@ko ;
    wf:reason "검증되지 않은 정의로 목차를 만드는 것을 방지"@ko ; wf:ontologyBasis "4번 신규에 따른 연결"@ko .
wf:vc04 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 6 ; wf:resultingStep wf:step07 ; wf:changeType "변경" ;
    wf:change "입력에 토픽 목록 추가, map 항목과 일치 확인"@ko ;
    wf:reason "토픽 목록을 사용하는 단계가 없었음"@ko ; wf:ontologyBasis "R3 경고 해소"@ko .
wf:vc05 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 10 ; wf:resultingStep wf:step16 ; wf:changeType "통합" ;
    wf:change "v2 10번(용어 검사 결과 검토)을 16번 검증 결과 확인에 통합. 10번 용어 검사 리포트를 다른 리포트와 함께 검토하고, 필요 시 용어집을 갱신해 이후 단계의 '최신 용어집'으로 사용"@ko ;
    wf:reason "사람 검토를 한 번으로 줄임. 갱신된 용어집을 사용하는 단계가 없던 문제(R3)도 함께 해소"@ko ; wf:ontologyBasis "R3 경고 해소"@ko ; wf:justifiedBy wf:Decision13 .
wf:vc06 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 11 ; wf:resultingStep wf:step11 , wf:step12 , wf:step13 , wf:step14 ; wf:changeType "변경" ;
    wf:change "입력 '토픽'을 '검증 대상 토픽 (1회차: 9번 출력, 재검증: 17번 출력)'으로 명시"@ko ;
    wf:reason "회차별로 어느 산출물을 검증하는지 원문에 없었음"@ko ; wf:ontologyBasis "입력 모호성 해소 (wf:aliasOf)"@ko .
wf:vc07 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 15 ; wf:resultingStep wf:step15 ; wf:changeType "변경" ;
    wf:change "입력을 '검증 대상 토픽', '최신 용어집'으로 명시"@ko ;
    wf:reason "갱신된 용어집이 내용 검증에 반영되는지 불분명했음"@ko ; wf:ontologyBasis "R3 경고 해소"@ko .
wf:vc08 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 16 ; wf:resultingStep wf:step16 ; wf:changeType "변경" ;
    wf:change "최종 토픽 확정 출력 추가, 재검증 회차 diff 입력 추가, 반복 상한 도달 시 직접 수정·예외 승인 분기 추가"@ko ;
    wf:reason "최종 토픽을 만드는 단계가 없었고, 예외 승인이 단계나 분기로 정의되지 않았음"@ko ;
    wf:ontologyBasis "R2 위반 해소, R3 경고 해소, 정의 공백 해소"@ko .
wf:vc09 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 17 ; wf:resultingStep wf:step17 ; wf:changeType "변경" ;
    wf:change "용어 치환용 '최신 용어집'을 입력으로 명시"@ko ;
    wf:reason "용어 치환을 자동 처리하지만 기준 용어집이 입력에 없었음"@ko ; wf:ontologyBasis "입력 누락 보완"@ko .
wf:vc10 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 18 ; wf:resultingStep wf:step18 ; wf:changeType "변경" ;
    wf:change "입력 '최종 토픽'의 출처를 16번으로 명시"@ko ; wf:ontologyBasis "R2 위반 해소"@ko .
wf:vc11 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 19 ; wf:resultingStep wf:step19 ; wf:changeType "변경" ;
    wf:change "입력에 예외 승인 기록 추가. 내용 문제 반려 시 반복 상한이면 16번 상한 처리 규칙을 따름"@ko ;
    wf:reason "예외 승인된 잔여 오류를 납품 전에 확인. 3회 소진 후 반려 처리 규칙이 없었음"@ko ; wf:ontologyBasis "정의 공백 해소"@ko .
wf:vc12 a wf:ChangeRecord ; wf:baseline "v2→v3" ; wf:previousStepNumber 3 ; wf:resultingStep wf:step03 ; wf:changeType "변경" ;
    wf:change "4번에서 돌아온 경우 워크플로우 검증 리포트를 입력으로 추가하고 위반 항목을 해소"@ko ;
    wf:reason "4번 검증에서 위반이 나오면 사람이 단계 추가·제외를 다시 결정해야 함"@ko ; wf:ontologyBasis "R3: 검증 리포트의 사용처 지정"@ko .

# ---- v3 결정 반영 (2026-10-29) ----
wf:uc01 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 1 ; wf:resultingStep wf:step01 ; wf:changeType "변경" ;
    wf:change "입력 '일반 매뉴얼 템플릿' 삭제. 작업 내용에 매뉴얼 종류 1개 선택(사용자·설치·서비스·운영·유지보수) 명시. 프로젝트 정의서에 project-profile.yaml 통합"@ko ;
    wf:reason "매뉴얼 종류마다 성격이 달라 공통 템플릿을 쓰지 않음. 프로젝트 파일 수를 줄여 중복 입력 오류 방지"@ko ; wf:justifiedBy wf:Decision4 , wf:Decision5 , wf:Decision7 .
wf:uc02 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 6 ; wf:resultingStep wf:step06 ; wf:changeType "변경" ;
    wf:change "프로젝트 정의서의 매뉴얼 종류에 해당하는 목차 기본 템플릿(5종 중 1개) 사용 명시"@ko ;
    wf:reason "일반 매뉴얼 템플릿을 대신함"@ko ; wf:justifiedBy wf:Decision4 , wf:Decision5 .
wf:uc03 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 7 ; wf:resultingStep wf:step07 , wf:step09 ; wf:changeType "변경" ;
    wf:change "체크리스트를 매뉴얼 종류별 5종 중 프로젝트 종류 1개로 사용"@ko ;
    wf:reason "매뉴얼 종류마다 필수 정보 요소가 다름"@ko ; wf:justifiedBy wf:Decision4 .
wf:uc04 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 6 ; wf:resultingStep wf:step06 ; wf:changeType "변경" ;
    wf:change "구분 LLM → LLM+스크립트. 스크립트가 매뉴얼 종류 목록으로 목차 섹션 라이브러리·분야 프로필·체크리스트 라이브러리를 병합해 병합 목차 템플릿과 병합 체크리스트를 출력, LLM이 병합 목차 템플릿으로 목차 작성"@ko ;
    wf:reason "통합 매뉴얼을 종류 조합마다 새 템플릿으로 만들지 않기 위해. 병합은 매번 같은 결과가 나와야 하므로 스크립트"@ko ; wf:justifiedBy wf:Decision10 , wf:Decision11 .
wf:uc05 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 7 ; wf:resultingStep wf:step07 , wf:step09 ; wf:changeType "변경" ;
    wf:change "체크리스트를 리소스 대신 6번 출력인 병합 체크리스트로 입력. 7번은 병합 목차 템플릿도 입력으로 받아 필수 섹션 누락 확인"@ko ;
    wf:reason "프로젝트의 종류 목록에 맞는 항목만 확인"@ko ; wf:justifiedBy wf:Decision10 .
wf:uc06 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 8 ; wf:resultingStep wf:step08 , wf:step15 ; wf:changeType "변경" ;
    wf:change "분야 프로필을 에이전트 가변부 리소스로 사용하고 외부 전송 목록에 추가"@ko ;
    wf:reason "분야 맥락을 에이전트 가변부로 주입 (아키텍처 방향)"@ko ; wf:justifiedBy wf:Decision11 .
wf:uc07 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 17 ; wf:resultingStep wf:step16 ; wf:changeType "통합" ;
    wf:change "v3 초안 11번(용어 검사 결과 검토, 사람)을 삭제하고 16번 검증 결과 확인에 통합. 10번 용어 검사 리포트(1회차)를 16번 입력에 추가하고 용어집 갱신도 16번에서 결정. 12~20번 → 11~19번"@ko ;
    wf:reason "사람 검토를 한 번으로 줄여 시간과 비용 절감. 용어 검사 스크립트(10번)는 유지"@ko ; wf:justifiedBy wf:Decision13 .

# ---- v3 결정 반영 (2026-11-04) ----
wf:uc08 a wf:ChangeRecord ; wf:baseline "v3 결정 반영" ; wf:previousStepNumber 13 ; wf:resultingStep wf:step13 ; wf:changeType "변경" ;
    wf:change "입력에 '승인된 DITA map' 추가 (검증 대상 토픽, 승인된 DITA map, 규칙 목록)"@ko ;
    wf:reason "13번 규칙 R13-001(맵 navtitle = 토픽 title)은 맵과 토픽을 함께 읽어야 실행됨. 11·12·14번 검증 단계와 같은 입력 구성"@ko ; wf:justifiedBy wf:Decision14 , wf:Decision15 .
