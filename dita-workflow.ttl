@prefix wf:      <https://example.org/dita-wf#> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =====================================================================
#  DITA 매뉴얼 1차 초안 자동화 워크플로우 (확정안 v3) — 온톨로지 표현
#  원본: DITA 워크플로우 엑셀 (시트: 워크플로우 / 반복·분기 규칙 / 변경 이력)
#  재사용 어휘: P-Plan (http://purl.org/net/p-plan#), PROV-O (http://www.w3.org/ns/prov#)
#  네임스페이스 https://example.org/dita-wf# 는 예시용 자리표시자입니다.
# =====================================================================

<https://example.org/dita-wf>
    a owl:Ontology ;
    rdfs:label "DITA 매뉴얼 초안 자동화 워크플로우 온톨로지"@ko ;
    dcterms:source "DITA 워크플로우 확정안 v3 (엑셀, 온톨로지 검증 반영)" ;
    owl:imports <http://purl.org/net/p-plan> .

# =====================================================================
#  PART 1. 스키마 (TBox) — 클래스
# =====================================================================

wf:Workflow  a owl:Class ; rdfs:subClassOf p-plan:Plan ;
    rdfs:label "워크플로우"@ko , "Workflow"@en .

# ---- 단계: '무엇을 하는가'(기능) 축 ----
wf:Step  a owl:Class ; rdfs:subClassOf p-plan:Step ;
    rdfs:label "단계"@ko , "Step"@en .
wf:DefinitionStep  a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "정의 단계"@ko .
wf:ProposalStep    a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "제안 단계"@ko .
wf:CreationStep    a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "작성·생성 단계"@ko .
wf:ApprovalStep    a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "승인 단계"@ko .
wf:ReviewStep      a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "검토 단계"@ko .
wf:DecisionStep    a owl:Class ; rdfs:subClassOf wf:ReviewStep ; rdfs:label "판단·결정 단계"@ko .
wf:ValidationStep  a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "검증 단계"@ko .
wf:CorrectionStep  a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "수정 단계"@ko .
wf:PublishingStep  a owl:Class ; rdfs:subClassOf wf:Step ; rdfs:label "출력 단계"@ko .

wf:Terminal  a owl:Class ; rdfs:label "종료 지점"@ko .

# ---- 수행 주체: '누가 하는가' 축 (엑셀 '구분'·C·D·E 열) ----
wf:Human     a owl:Class ; rdfs:subClassOf prov:Person ;        rdfs:label "사람"@ko .
wf:LLMAgent  a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "LLM 에이전트"@ko .
wf:Script    a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "스크립트"@ko .

# ---- 자료: 입력·출력 (엑셀 G·H·I 열) ----
wf:Artifact        a owl:Class ; rdfs:subClassOf p-plan:Variable ; rdfs:label "자료"@ko .
wf:SourceMaterial  a owl:Class ; rdfs:subClassOf wf:Artifact ; rdfs:label "근거 자료"@ko .
wf:ExternalStandard a owl:Class ; rdfs:subClassOf wf:Artifact ; rdfs:label "외부 표준·스키마"@ko .
wf:Resource        a owl:Class ; rdfs:subClassOf wf:Artifact ; rdfs:label "작업 리소스(템플릿·도구)"@ko .
wf:Template        a owl:Class ; rdfs:subClassOf wf:Resource ; rdfs:label "템플릿·양식·체크리스트"@ko .
wf:TemplatePart    a owl:Class ; rdfs:subClassOf wf:Resource ; rdfs:label "라이브러리 안의 종류별 묶음"@ko ;
    rdfs:comment "파일이 아니라 라이브러리 템플릿 안에서 특정 매뉴얼 종류 태그가 붙은 섹션·항목 묶음 (결정 10)"@ko .
wf:Tool            a owl:Class ; rdfs:subClassOf wf:Resource ; rdfs:label "도구"@ko .
wf:LLMSkill        a owl:Class ; rdfs:subClassOf wf:Tool ;     rdfs:label "LLM 스킬"@ko .
wf:WorkProduct     a owl:Class ; rdfs:subClassOf wf:Artifact ; rdfs:label "작업 산출물"@ko .
wf:DITAMap         a owl:Class ; rdfs:subClassOf wf:WorkProduct ; rdfs:label "DITA map"@ko .
wf:DITATopicSet    a owl:Class ; rdfs:subClassOf wf:WorkProduct ; rdfs:label "DITA 토픽 묶음"@ko .
wf:Report          a owl:Class ; rdfs:subClassOf wf:WorkProduct ; rdfs:label "리포트"@ko .
wf:FinalDeliverable a owl:Class ; rdfs:subClassOf wf:WorkProduct ; rdfs:label "최종 출력물"@ko .

wf:TopicState      a owl:Class ; rdfs:label "토픽 상태"@ko .
wf:ManualType      a owl:Class ; rdfs:label "매뉴얼 종류"@ko ;
    rdfs:comment "사용자·설치·서비스·운영·유지보수 5종을 별개 종류로 산정 (결정 D4)"@ko .
wf:Availability    a owl:Class ; rdfs:label "리소스 준비 상태"@ko .

# ---- 흐름 제어 (엑셀 J열, '반복·분기 규칙' 시트) ----
wf:Transition      a owl:Class ; rdfs:label "전이(다음 단계·분기)"@ko ;
    rdfs:comment "조건이 붙은 흐름. p-plan:isPrecededBy는 추이적(transitive)이라 되돌아가는 흐름(반려, 재검증)을 표현하면 순환이 생기므로, 분기·반복은 이 클래스로 따로 표현한다."@ko .
wf:Condition       a owl:Class ; rdfs:label "전이 조건"@ko .
wf:RejectionCondition a owl:Class ; rdfs:subClassOf wf:Condition ; rdfs:label "반려 조건"@ko .
wf:IterationRule   a owl:Class ; rdfs:label "반복 규칙"@ko .
wf:SkipRule        a owl:Class ; rdfs:label "검증 생략 규칙"@ko .

# ---- 제약·보안 (엑셀 F·K열) ----
wf:Constraint            a owl:Class ; rdfs:label "작업 제약"@ko .
wf:ScopeConstraint       a owl:Class ; rdfs:subClassOf wf:Constraint ; rdfs:label "작업 범위 제약"@ko .
wf:IndependenceConstraint a owl:Class ; rdfs:subClassOf wf:Constraint ; rdfs:label "독립성 제약"@ko .
wf:SecurityConstraint    a owl:Class ; rdfs:subClassOf wf:Constraint ; rdfs:label "보안 제약"@ko .
wf:ExternalTransmission  a owl:Class ; rdfs:label "외부 전송(LLM API)"@ko .
wf:TransmissionCondition a owl:Class ; rdfs:label "전송 조건"@ko .

# ---- 변경 이력 ('변경 이력' 시트) ----
wf:OriginalStep  a owl:Class ; rdfs:label "원안 단계"@ko .
wf:Decision      a owl:Class ; rdfs:label "결정 사항"@ko .
wf:ChangeRecord  a owl:Class ; rdfs:label "변경 기록"@ko .

# =====================================================================
#  PART 1. 스키마 (TBox) — 속성
# =====================================================================

wf:stepNumber   a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:integer ; rdfs:label "순서"@ko .
wf:task         a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:string ; rdfs:label "작업 내용"@ko .
wf:performedBy  a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain wf:Step ; rdfs:range prov:Agent ; rdfs:label "수행 주체"@ko .
wf:usesResource a owl:ObjectProperty ; rdfs:domain wf:Step ; rdfs:range wf:Resource ; rdfs:label "필요 에이전트/템플릿"@ko .
wf:availability a owl:ObjectProperty ; rdfs:domain wf:Resource ; rdfs:range wf:Availability ; rdfs:label "준비 상태"@ko .
wf:templateId a owl:DatatypeProperty ; rdfs:domain wf:Resource ; rdfs:range xsd:string ; rdfs:label "템플릿 ID"@ko ;
    rdfs:comment "엑셀 '템플릿 목록' 시트의 ID (T01~T39)"@ko .
wf:recommendedFormat a owl:DatatypeProperty ; rdfs:domain wf:Resource ; rdfs:range xsd:string ; rdfs:label "권장 파일 포맷"@ko .
wf:forManualType a owl:ObjectProperty ; rdfs:domain wf:Resource ; rdfs:range wf:ManualType ; rdfs:label "대상 매뉴얼 종류"@ko .
wf:partOf a owl:ObjectProperty ; rdfs:domain wf:TemplatePart ; rdfs:range wf:Resource ; rdfs:label "포함된 라이브러리"@ko .
wf:typeCode a owl:DatatypeProperty ; rdfs:domain wf:ManualType ; rdfs:range xsd:string ; rdfs:label "종류 코드"@ko .
wf:decidedBy a owl:DatatypeProperty ; rdfs:domain wf:Decision ; rdfs:label "결정 주체"@ko .
wf:decidedOn a owl:DatatypeProperty ; rdfs:domain wf:Decision ; rdfs:label "결정일"@ko .
wf:conditionalUse a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "사용 조건"@ko .
wf:hasState     a owl:ObjectProperty ; rdfs:domain wf:DITATopicSet ; rdfs:range wf:TopicState ; rdfs:label "상태"@ko .
wf:aliasOf      a owl:ObjectProperty ; rdfs:domain wf:Artifact ; rdfs:range wf:Artifact ;
    rdfs:label "실제로 가리키는 자료"@ko ;
    rdfs:comment "원문이 '토픽'처럼 일반 명칭으로 적은 입력이 회차에 따라 어느 산출물을 뜻하는지 연결"@ko .
wf:securityControlled a owl:DatatypeProperty ; rdfs:domain wf:Artifact ; rdfs:range xsd:boolean ; rdfs:label "보안 등급 통제 대상"@ko .
wf:usageRestriction   a owl:DatatypeProperty ; rdfs:domain wf:Artifact ; rdfs:range xsd:string ; rdfs:label "사용 제한"@ko .

wf:fromStep  a owl:ObjectProperty ; rdfs:domain wf:Transition ; rdfs:range wf:Step ; rdfs:label "출발 단계"@ko .
wf:toStep    a owl:ObjectProperty ; rdfs:domain wf:Transition ; rdfs:label "도착 단계"@ko .
wf:onCondition a owl:ObjectProperty ; rdfs:domain wf:Transition ; rdfs:range wf:Condition ; rdfs:label "조건"@ko .
wf:countsTowardIteration a owl:DatatypeProperty ; rdfs:domain wf:Transition ; rdfs:range xsd:boolean ; rdfs:label "반복 횟수 포함"@ko .
wf:governedBy a owl:ObjectProperty ; rdfs:domain wf:Transition ; rdfs:range wf:IterationRule ; rdfs:label "적용 반복 규칙"@ko .

wf:loopBody      a owl:ObjectProperty ; rdfs:domain wf:IterationRule ; rdfs:range wf:Step ; rdfs:label "반복 구간 단계"@ko .
wf:maxIterations a owl:DatatypeProperty ; rdfs:domain wf:IterationRule ; rdfs:range xsd:integer ; rdfs:label "최대 반복 횟수"@ko .
wf:exitOnPassTo  a owl:ObjectProperty ; rdfs:domain wf:IterationRule ; rdfs:range wf:Step ; rdfs:label "통과 시 이동"@ko .
wf:onErrorsRemainTo a owl:ObjectProperty ; rdfs:domain wf:IterationRule ; rdfs:range wf:Step ; rdfs:label "오류 잔존 시 이동"@ko .
wf:onLimitReached a owl:DatatypeProperty ; rdfs:domain wf:IterationRule ; rdfs:label "상한 도달 시 처리"@ko .
wf:errorCountingRule a owl:DatatypeProperty ; rdfs:domain wf:IterationRule ; rdfs:label "오류 집계 기준"@ko .
wf:passRule a owl:DatatypeProperty ; rdfs:domain wf:IterationRule ; rdfs:label "통과 시 처리"@ko .

wf:triggeredByFailureOf a owl:ObjectProperty ; rdfs:domain wf:SkipRule ; rdfs:range wf:Step ; rdfs:label "실패 발생 단계"@ko .
wf:skips      a owl:ObjectProperty ; rdfs:domain wf:SkipRule ; rdfs:range wf:Step ; rdfs:label "생략 단계"@ko .
wf:scope      a owl:DatatypeProperty ; rdfs:label "적용 단위"@ko .
wf:alwaysExecutes a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:boolean ; rdfs:label "항상 실행"@ko .

wf:hasConstraint  a owl:ObjectProperty ; rdfs:range wf:Constraint ; rdfs:label "제약"@ko .
wf:prohibits      a owl:DatatypeProperty ; rdfs:domain wf:Constraint ; rdfs:label "금지 내용"@ko .
wf:placeholderMarker a owl:DatatypeProperty ; rdfs:domain wf:Constraint ; rdfs:label "대체 표시"@ko .
wf:mustUseDifferentPromptThan a owl:ObjectProperty ; rdfs:domain wf:Step ; rdfs:range wf:Step ; rdfs:label "다른 지시문 사용 대상"@ko .
wf:outOfScopeDelegatedTo a owl:ObjectProperty ; rdfs:domain wf:Step ; rdfs:range wf:Step ; rdfs:label "범위 밖 판단 위임 단계"@ko .
wf:requiresExclusionReason a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:boolean ; rdfs:label "제외 시 사유 필수"@ko .

wf:sendsToExternalLLM a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:boolean ;
    rdfs:label "LLM API 외부 전송 여부"@ko ;
    rdfs:comment "엑셀의 '없음'을 명시적으로 false로 기록. OWL은 열린 세계 가정을 따르므로 기록이 없으면 '전송 안 함'이 아니라 '모름'으로 해석된다."@ko .
wf:hasExternalTransmission a owl:ObjectProperty ; rdfs:domain wf:Step ; rdfs:range wf:ExternalTransmission ; rdfs:label "외부 전송"@ko .
wf:transmits    a owl:ObjectProperty ; rdfs:domain wf:ExternalTransmission ; rdfs:range wf:Artifact ; rdfs:label "전송 자료"@ko .
wf:conditionalOn a owl:ObjectProperty ; rdfs:domain wf:ExternalTransmission ; rdfs:range wf:TransmissionCondition ; rdfs:label "전송 조건"@ko .
wf:optionalLLMUse a owl:DatatypeProperty ; rdfs:domain wf:Step ; rdfs:range xsd:boolean ; rdfs:label "선택적 LLM 사용"@ko .

wf:originalStep  a owl:ObjectProperty ; rdfs:domain wf:ChangeRecord ; rdfs:range wf:OriginalStep ; rdfs:label "원안 단계"@ko .
wf:resultingStep a owl:ObjectProperty ; rdfs:domain wf:ChangeRecord ; rdfs:range wf:Step ; rdfs:label "확정안 단계"@ko .
wf:changeType    a owl:DatatypeProperty ; rdfs:domain wf:ChangeRecord ; rdfs:label "변경 유형"@ko .
wf:change        a owl:DatatypeProperty ; rdfs:domain wf:ChangeRecord ; rdfs:label "변경 내용"@ko .
wf:reason        a owl:DatatypeProperty ; rdfs:label "사유"@ko .
wf:justifiedBy   a owl:ObjectProperty ; rdfs:range wf:Decision ; rdfs:label "근거 결정 사항"@ko .
wf:baseline      a owl:DatatypeProperty ; rdfs:domain wf:ChangeRecord ; rdfs:label "비교 기준 (원안→v2 / v2→v3)"@ko .
wf:previousStepNumber a owl:DatatypeProperty ; rdfs:domain wf:ChangeRecord ; rdfs:range xsd:integer ; rdfs:label "이전 버전 단계 번호"@ko .
wf:ontologyBasis a owl:DatatypeProperty ; rdfs:domain wf:ChangeRecord ; rdfs:label "온톨로지 검증 근거"@ko .

# =====================================================================
#  PART 2. 공통 개체 (조건·상태·주체)
# =====================================================================

wf:Always      a wf:Condition ; rdfs:label "무조건"@ko .
wf:Approved    a wf:Condition ; rdfs:label "승인"@ko .
wf:Rejected    a wf:RejectionCondition ; rdfs:label "반려"@ko .
wf:LayoutIssue a wf:RejectionCondition ; rdfs:label "레이아웃 문제"@ko .
wf:ContentIssue a wf:RejectionCondition ; rdfs:label "내용 문제"@ko .
wf:HasFixItems a wf:Condition ; rdfs:label "수정 항목 있음"@ko .
wf:NoFixItems  a wf:Condition ; rdfs:label "수정 항목 없음"@ko .
wf:NoViolations a wf:Condition ; rdfs:label "위반 0건"@ko .
wf:ViolationsFound a wf:RejectionCondition ; rdfs:label "위반 있음"@ko .
wf:LimitReachedDirectFix a wf:Condition ; rdfs:label "상한 도달·직접 수정"@ko .
wf:ExceptionApproved a wf:Condition ; rdfs:label "상한 도달·예외 승인"@ko .

wf:Draft         a wf:TopicState ; rdfs:label "초안"@ko .
wf:Reviewed      a wf:TopicState ; rdfs:label "검토됨"@ko .
wf:Corrected     a wf:TopicState ; rdfs:label "오류 수정됨"@ko .
wf:Final         a wf:TopicState ; rdfs:label "최종"@ko .

wf:Available   a wf:Availability ; rdfs:label "있음"@ko .
wf:Sample      a wf:Availability ; rdfs:label "샘플 (표준화 필요)"@ko .
wf:Partial     a wf:Availability ; rdfs:label "일부"@ko .
wf:Unconfirmed a wf:Availability ; rdfs:label "확인 필요"@ko .
wf:ToBeCreated a wf:Availability ; rdfs:label "작성 필요"@ko .

wf:SecurityClearance a wf:TransmissionCondition ; rdfs:label "보안 등급 허용 시"@ko .
wf:PromptTranslatorInUse a wf:TransmissionCondition ; rdfs:label "prompt-translator 사용 시"@ko .
wf:JudgmentRuleUsesLLM a wf:TransmissionCondition ; rdfs:label "판단형 규칙에 LLM 사용 시"@ko .

wf:Writer a wf:Human ; rdfs:label "작업자"@ko .

wf:agentWorkflowExtractor a wf:LLMAgent ; rdfs:label "워크플로우 추출 (제안)"@ko .
wf:agentMapGenerator      a wf:LLMAgent ; rdfs:label "목차(DITA map) 생성"@ko .
wf:agentTopicGenerator    a wf:LLMAgent ; rdfs:label "DITA 토픽 초안 생성"@ko .
wf:agentContentChecker    a wf:LLMAgent ; rdfs:label "내용 일관성 검증 (LLM)"@ko .
wf:agentFixer             a wf:LLMAgent ; rdfs:label "오류 사항 수정 및 반영 (LLM)"@ko .

wf:scriptTermCheck     a wf:Script ; rdfs:label "용어집 대비 용어 일치 검사"@ko .
wf:scriptWellFormed    a wf:Script ; rdfs:label "XML 정형성 검증 (xmllint 또는 lxml)"@ko .
wf:scriptDitaValidate  a wf:Script ; rdfs:label "DITA 유효성 검증 (dita validate)"@ko .
wf:scriptRuleCheck     a wf:Script ; rdfs:label "DITA 규칙 검증 (Schematron 등)"@ko .
wf:scriptBuild         a wf:Script ; rdfs:label "DITA-OT 빌드, 로그 분류, 링크 검사"@ko .
wf:scriptContentCheck  a wf:Script ; rdfs:label "내용 일관성 검증 (스크립트)"@ko .
wf:scriptFixer         a wf:Script ; rdfs:label "오류 사항 수정 및 반영 (스크립트)"@ko .
wf:scriptPublish       a wf:Script ; rdfs:label "PDF/HTML 변환 (DITA-OT)"@ko .
wf:scriptTocMerge a wf:Script ; rdfs:label "목차·체크리스트 병합 (종류 목록 기준)"@ko .
wf:scriptWorkflowValidator a wf:Script ; rdfs:label "워크플로우 정의 검증 (SHACL, pyshacl 등)"@ko .

# =====================================================================
#  PART 3. 자료 개체 (엑셀 G·H·I·K 열)
# =====================================================================

# ---- 근거 자료 ----
wf:Spec a wf:SourceMaterial ; rdfs:label "사양서"@ko ; wf:securityControlled true .
wf:CompetitorManual a wf:SourceMaterial ; rdfs:label "타사 참고 매뉴얼"@ko ;
    wf:usageRestriction "목차 구조만 추출해 사용 (문장이 그대로 옮겨질 위험 방지)"@ko .
wf:ExistingManual a wf:SourceMaterial ; rdfs:label "기존 매뉴얼"@ko .
wf:UserInputText a wf:SourceMaterial ; rdfs:label "입력 문장"@ko .
wf:DTD a wf:ExternalStandard ; rdfs:label "DTD (특수화 사용 시 스키마·XML 카탈로그)"@ko .

# ---- 템플릿·도구 ----
wf:PromptTranslatorSkill a wf:LLMSkill ; rdfs:label "prompt-translator 스킬"@ko ; wf:availability wf:Available .
wf:ProjectDefinitionForm a wf:Template ; rdfs:label "프로젝트 정의서 양식"@ko ; wf:availability wf:Sample ; wf:templateId "T01" ; wf:recommendedFormat "YAML 1.2" .
wf:WorkflowOntology a wf:Template ; rdfs:label "문서 작성 워크플로우 온톨로지 (dita-workflow.ttl)"@ko ; wf:availability wf:Available ; wf:templateId "T03" ; wf:recommendedFormat "Turtle (.ttl, RDF)" ;
    rdfs:comment "v2의 '문서 작성 워크플로우 템플릿'을 대체. 단계·입출력·전이·규칙을 기계가 읽는 형태로 정의"@ko .
wf:WorkflowShapes a wf:Template ; rdfs:label "워크플로우 검증 규칙 (dita-workflow-shapes.ttl, R1~R8)"@ko ; wf:availability wf:Available ; wf:templateId "T29" ; wf:recommendedFormat "Turtle (.ttl, SHACL)" .
wf:WorkflowValidationScript a wf:Tool ; rdfs:label "워크플로우 검증 스크립트"@ko ; wf:availability wf:ToBeCreated .
wf:GlossaryTemplate a wf:Template ; rdfs:label "용어집 템플릿"@ko ; wf:availability wf:Sample ; wf:templateId "T05" ; wf:recommendedFormat "YAML 1.2 (원본)" .
wf:TOCTemplate a wf:Template ; rdfs:label "목차 섹션 라이브러리 (매뉴얼 종류 태그)"@ko ; wf:availability wf:Partial ; wf:templateId "T06" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist a wf:Template ; rdfs:label "체크리스트 라이브러리 (매뉴얼 종류 태그)"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T10" ; wf:recommendedFormat "YAML 1.2" .
wf:TopicTemplate a wf:Template ; rdfs:label "DITA 토픽별 템플릿"@ko ; wf:availability wf:Available ; wf:templateId "T11" ; wf:recommendedFormat "DITA 1.3 (.dita)" .
wf:TermCheckScriptRes a wf:Tool ; rdfs:label "용어 검사 스크립트"@ko ; wf:availability wf:Available .
wf:SchemaTemplate a wf:Template ; rdfs:label "스키마 템플릿"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T38" ; wf:recommendedFormat "DTD 또는 RNG + OASIS XML catalog" ;
    wf:conditionalUse "특수화 사용 시"@ko .
wf:RuleList a wf:Template ; rdfs:label "규칙 목록"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T19" ; wf:recommendedFormat "YAML 1.2 (원본) → Schematron .sch (생성)" .
wf:LogClassificationTable a wf:Template ; rdfs:label "로그 분류표 (메시지 ID → 원인·조치)"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T33" ; wf:recommendedFormat "YAML 1.2" .
wf:VerificationChecklist a wf:Template ; rdfs:label "검증 체크리스트"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T20" ; wf:recommendedFormat "YAML 1.2" .
wf:DomainProfile a wf:Template ; rdfs:label "분야 프로필 (목차 분야 덧붙임 통합)"@ko ; wf:availability wf:ToBeCreated ; wf:templateId "T07" ; wf:recommendedFormat "YAML 1.2" ;
    rdfs:comment "분야당 1개. 매뉴얼 종류별 목차 덧붙임 + 에이전트 가변부용 분야 맥락 (결정 11)"@ko .
wf:OutputPlugin a wf:Tool ; rdfs:label "출력 플러그인·스타일"@ko ; wf:availability wf:Partial ; wf:templateId "T23·T24" ; wf:recommendedFormat "DITA-OT PDF 테마 (YAML) + 글꼴 설정 · CSS + .properties" .

# ---- 매뉴얼 종류와 종류별 템플릿 (결정 D4·D5) ----
wf:mt_user a wf:ManualType ; rdfs:label "사용자 매뉴얼"@ko ; wf:typeCode "USR" .
wf:mt_operation a wf:ManualType ; rdfs:label "운영 매뉴얼"@ko ; wf:typeCode "OPS" .
wf:mt_installation a wf:ManualType ; rdfs:label "설치 매뉴얼"@ko ; wf:typeCode "INS" .
wf:mt_service a wf:ManualType ; rdfs:label "서비스 매뉴얼"@ko ; wf:typeCode "SVC" .
wf:mt_maintenance a wf:ManualType ; rdfs:label "유지보수 매뉴얼"@ko ; wf:typeCode "MNT" .
wf:TOCTemplate_USR a wf:TemplatePart ; rdfs:label "목차 섹션 — 사용자 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:TOCTemplate ; wf:forManualType wf:mt_user ;
    wf:availability wf:ToBeCreated ; wf:templateId "T06 · USR" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist_USR a wf:TemplatePart ; rdfs:label "체크리스트 항목 — 사용자 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:ManualChecklist ; wf:forManualType wf:mt_user ;
    wf:availability wf:ToBeCreated ; wf:templateId "T10 · USR" ; wf:recommendedFormat "YAML 1.2" .
wf:TOCTemplate_OPS a wf:TemplatePart ; rdfs:label "목차 섹션 — 운영 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:TOCTemplate ; wf:forManualType wf:mt_operation ;
    wf:availability wf:ToBeCreated ; wf:templateId "T06 · OPS" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist_OPS a wf:TemplatePart ; rdfs:label "체크리스트 항목 — 운영 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:ManualChecklist ; wf:forManualType wf:mt_operation ;
    wf:availability wf:ToBeCreated ; wf:templateId "T10 · OPS" ; wf:recommendedFormat "YAML 1.2" .
wf:TOCTemplate_INS a wf:TemplatePart ; rdfs:label "목차 섹션 — 설치 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:TOCTemplate ; wf:forManualType wf:mt_installation ;
    wf:availability wf:Available ; wf:templateId "T06 · INS" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist_INS a wf:TemplatePart ; rdfs:label "체크리스트 항목 — 설치 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:ManualChecklist ; wf:forManualType wf:mt_installation ;
    wf:availability wf:ToBeCreated ; wf:templateId "T10 · INS" ; wf:recommendedFormat "YAML 1.2" .
wf:TOCTemplate_SVC a wf:TemplatePart ; rdfs:label "목차 섹션 — 서비스 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:TOCTemplate ; wf:forManualType wf:mt_service ;
    wf:availability wf:ToBeCreated ; wf:templateId "T06 · SVC" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist_SVC a wf:TemplatePart ; rdfs:label "체크리스트 항목 — 서비스 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:ManualChecklist ; wf:forManualType wf:mt_service ;
    wf:availability wf:ToBeCreated ; wf:templateId "T10 · SVC" ; wf:recommendedFormat "YAML 1.2" .
wf:TOCTemplate_MNT a wf:TemplatePart ; rdfs:label "목차 섹션 — 유지보수 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:TOCTemplate ; wf:forManualType wf:mt_maintenance ;
    wf:availability wf:ToBeCreated ; wf:templateId "T06 · MNT" ; wf:recommendedFormat "YAML 1.2" .
wf:ManualChecklist_MNT a wf:TemplatePart ; rdfs:label "체크리스트 항목 — 유지보수 매뉴얼 (라이브러리 내)"@ko ; wf:partOf wf:ManualChecklist ; wf:forManualType wf:mt_maintenance ;
    wf:availability wf:ToBeCreated ; wf:templateId "T10 · MNT" ; wf:recommendedFormat "YAML 1.2" .

# ---- 작업 산출물 ----
wf:ProjectDefinition a wf:WorkProduct ; rdfs:label "프로젝트 정의서"@ko ;
    rdfs:comment "제품군, 매뉴얼 종류 목록(5종 중 1개 이상), 대상 독자, 출력 언어, 형식, 출력, 보안 등급, 목차 참고, 통과 기준, 에이전트 가변부 값 포함. project-profile.yaml을 통합한 단일 프로젝트 파일 (결정 D7)"@ko .
wf:WorkflowProposal a wf:WorkProduct ; rdfs:label "워크플로우 제안서 (단계 목록 + 제외 사유)"@ko .
wf:ApprovedWorkflow a wf:WorkProduct ; rdfs:label "확정 워크플로우 (단계 목록)"@ko .
wf:ProjectWorkflowDefinition a wf:WorkProduct ; rdfs:label "프로젝트 워크플로우 정의 (.ttl, 검증 통과본)"@ko .
wf:WorkflowValidationReport a wf:Report ; rdfs:label "워크플로우 검증 리포트"@ko .
wf:Glossary a wf:WorkProduct ; rdfs:label "용어집 (승인어, 금지어, 다국어 대응어)"@ko .
wf:GlossaryUpdated a wf:WorkProduct ; rdfs:label "갱신된 용어집 (필요 시)"@ko ; prov:wasRevisionOf wf:Glossary .
wf:CurrentGlossary a wf:WorkProduct ; rdfs:label "최신 용어집"@ko ;
    wf:aliasOf wf:Glossary , wf:GlossaryUpdated ;
    rdfs:comment "16번에서 갱신했으면 갱신본, 아니면 5번 용어집"@ko .
wf:DitaMapDraft a wf:DITAMap ; rdfs:label "DITA map (.ditamap)"@ko .
wf:TopicList a wf:WorkProduct ; rdfs:label "토픽 목록"@ko .
wf:MergedTOCTemplate a wf:WorkProduct ; rdfs:label "병합 목차 템플릿 (merged-toc-template.yaml)"@ko ;
    rdfs:comment "6번 스크립트가 프로젝트의 매뉴얼 종류 목록으로 T06·T07에서 골라 병합. 공통 섹션은 1회, 본문은 수명주기 순서"@ko .
wf:MergedChecklist a wf:WorkProduct ; rdfs:label "병합 체크리스트 (merged-checklist.yaml)"@ko ;
    rdfs:comment "6번 스크립트가 프로젝트의 매뉴얼 종류 목록으로 T10에서 골라 병합"@ko .
wf:ApprovedDitaMap a wf:DITAMap ; rdfs:label "승인된 DITA map"@ko ; prov:wasRevisionOf wf:DitaMapDraft .

wf:TopicDraft a wf:DITATopicSet ; rdfs:label "토픽 초안 (.dita)"@ko ; wf:hasState wf:Draft .
wf:TopicReviewed a wf:DITATopicSet ; rdfs:label "검토된 토픽"@ko ; wf:hasState wf:Reviewed ; prov:wasRevisionOf wf:TopicDraft .
wf:TopicCorrected a wf:DITATopicSet ; rdfs:label "수정된 토픽"@ko ; wf:hasState wf:Corrected .
wf:TopicForVerification a wf:DITATopicSet ; rdfs:label "토픽 (검증·수정 대상)"@ko ;
    wf:aliasOf wf:TopicReviewed , wf:TopicCorrected ;
    rdfs:comment "11~15·17번의 입력 '검증 대상 토픽'. 1회차는 9번 출력, 재검증 회차는 17번 출력 (v3에서 엑셀 입력란에 명시)."@ko .
wf:FinalTopic a wf:DITATopicSet ; rdfs:label "최종 토픽"@ko ; wf:hasState wf:Final ;
    rdfs:comment "16번에서 확정(수정 항목 없음 또는 예외 승인 시 현재 검증 대상 토픽을 최종본으로 지정). v2에서는 생성 단계가 없었음(R2 위반)."@ko .

wf:TermCheckReport a wf:Report ; rdfs:label "용어 검사 리포트"@ko .
wf:WellFormednessReport a wf:Report ; rdfs:label "정형성 리포트"@ko .
wf:ValidityReport a wf:Report ; rdfs:label "유효성 리포트"@ko .
wf:RuleReport a wf:Report ; rdfs:label "규칙 검증 리포트"@ko .
wf:BuildLogReport a wf:Report ; rdfs:label "빌드 로그 리포트"@ko .
wf:LinkReport a wf:Report ; rdfs:label "링크 리포트"@ko .
wf:ContentReport a wf:Report ; rdfs:label "내용 검증 리포트"@ko .
wf:FixInstructions a wf:WorkProduct ; rdfs:label "수정 지시서 (항목별 수정 내용)"@ko .
wf:ExceptionApproval a wf:WorkProduct ; rdfs:label "예외 승인 기록 (잔여 오류·허용 사유)"@ko .
wf:Diff a wf:WorkProduct ; rdfs:label "diff (변경 전후 비교)"@ko .
wf:MaskedMetadata a wf:WorkProduct ; rdfs:label "마스킹된 메타데이터"@ko .
wf:OutputPDF a wf:FinalDeliverable ; rdfs:label "PDF"@ko .
wf:OutputHTML a wf:FinalDeliverable ; rdfs:label "HTML"@ko .
wf:ApprovedDeliverable a wf:FinalDeliverable ; rdfs:label "승인된 최종 출력물"@ko .

# =====================================================================
#  PART 4. 워크플로우와 단계 (엑셀 '워크플로우' 시트 1~19행)
# =====================================================================

wf:DitaDraftWorkflow a wf:Workflow ;
    rdfs:label "DITA 매뉴얼 1차 초안 자동화 워크플로우 (확정안 v3, 19단계)"@ko .

wf:step01 a wf:DefinitionStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 1 ; rdfs:label "제품·문서 종류 입력, 보안 등급 지정"@ko ;
    wf:task "작업 대상 정의(제품군, 매뉴얼 종류 선택: 사용자·설치·서비스·운영·유지보수 중 1개 이상(통합 매뉴얼은 여러 개), 대상 독자, 출력 언어). 보안 등급에 따라 사양서를 LLM에 입력할 수 있는지 결정"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:Spec , wf:CompetitorManual ;
    p-plan:hasOutputVar wf:ProjectDefinition ;
    wf:usesResource wf:PromptTranslatorSkill , wf:ProjectDefinitionForm ;
    wf:hasConstraint wf:c_CompetitorStructureOnly , wf:c_SecurityLevel ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:UserInputText ; wf:conditionalOn wf:PromptTranslatorInUse ] .

wf:step02 a wf:ProposalStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 2 ; rdfs:label "워크플로우 추출 (제안)"@ko ;
    wf:task "워크플로우 온톨로지에서 이 프로젝트에 필요한 단계를 골라 제안. 제외하는 단계마다 사유를 기록하고, 제외한 단계의 출력물을 쓰는 단계가 있으면 함께 표시"@ko ;
    wf:performedBy wf:agentWorkflowExtractor ;
    p-plan:hasInputVar wf:ProjectDefinition , wf:WorkflowOntology ;
    p-plan:hasOutputVar wf:WorkflowProposal ;
    wf:usesResource wf:WorkflowOntology ;
    p-plan:isPrecededBy wf:step01 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:ProjectDefinition ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:WorkflowOntology ] .

wf:step03 a wf:ApprovalStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 3 ; rdfs:label "워크플로우 승인"@ko ;
    wf:task "제안된 단계 목록을 검토해 추가·제외를 확정. 검증·승인 단계(4, 11~16, 19)를 제외할 때는 사유를 남김. 4번에서 돌아온 경우 검증 리포트의 위반 항목을 해소"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:WorkflowProposal , wf:WorkflowValidationReport ;
    p-plan:hasOutputVar wf:ApprovedWorkflow ;
    p-plan:isPrecededBy wf:step02 ;
    wf:sendsToExternalLLM false .

wf:step04 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 4 ; rdfs:label "워크플로우 정의 검증"@ko ;
    wf:task "확정 워크플로우의 단계 목록을 워크플로우 온톨로지에 적용해 프로젝트용 정의를 만들고, 검증 규칙(R1~R8)으로 끊긴 입출력, 누락된 분기, 조건 없는 사양서 전송, 상한 없는 반복을 검출. 위반(Violation)만 진행을 막고 경고·정보는 리포트에 기록"@ko ;
    wf:performedBy wf:scriptWorkflowValidator ;
    p-plan:hasInputVar wf:ApprovedWorkflow , wf:WorkflowOntology , wf:WorkflowShapes ;
    p-plan:hasOutputVar wf:ProjectWorkflowDefinition , wf:WorkflowValidationReport ;
    wf:usesResource wf:WorkflowValidationScript , wf:WorkflowShapes ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step03 ;
    wf:sendsToExternalLLM false .

wf:step05 a wf:CreationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 5 ; rdfs:label "상품군 용어집 추출"@ko ;
    wf:task "상품군에서 사용하는 용어를 추출해 용어집 작성"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:Spec , wf:ExistingManual ;
    p-plan:hasOutputVar wf:Glossary ;
    wf:usesResource wf:GlossaryTemplate ;
    p-plan:isPrecededBy wf:step04 ;
    wf:sendsToExternalLLM false .

wf:step06 a wf:CreationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 6 ; rdfs:label "목차(DITA map) 생성"@ko ;
    wf:task "스크립트가 프로젝트 정의서의 매뉴얼 종류 목록(1개 이상)으로 목차 섹션 라이브러리·분야 프로필·체크리스트 라이브러리에서 해당 섹션과 항목을 골라 병합(공통 섹션은 1회, 본문은 IEC/IEEE 82079-1 수명주기 순서)하고, LLM이 병합 목차 템플릿으로 기본 목차 작성. 목차 항목 제목에 용어집 적용"@ko ;
    wf:performedBy wf:agentMapGenerator , wf:scriptTocMerge ;
    p-plan:hasInputVar wf:ProjectDefinition , wf:ProjectWorkflowDefinition , wf:Glossary ;
    p-plan:hasOutputVar wf:DitaMapDraft , wf:TopicList , wf:MergedTOCTemplate , wf:MergedChecklist ;
    wf:usesResource wf:TOCTemplate , wf:ManualChecklist , wf:DomainProfile ;
    p-plan:isPrecededBy wf:step05 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:ProjectDefinition ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:Glossary ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:DomainProfile ] .

wf:step07 a wf:ApprovalStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 7 ; rdfs:label "목차 승인"@ko ;
    wf:task "목차 구조와 누락 항목을 검토해 승인. 토픽 목록과 map 항목이 일치하는지 확인. 토픽 생성 전에 목차를 확정해 재작업을 막음"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:DitaMapDraft , wf:TopicList , wf:MergedTOCTemplate , wf:MergedChecklist ;
    p-plan:hasOutputVar wf:ApprovedDitaMap ;
    p-plan:isPrecededBy wf:step06 ;
    wf:sendsToExternalLLM false .

wf:step08 a wf:CreationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 8 ; rdfs:label "DITA 토픽 초안 생성"@ko ;
    wf:task "승인된 목차 기준으로 일반 내용의 1차 초안 생성. 사양서에 없는 제품 고유 정보(세부 절차, UI 명칭, 수치, 안전 메시지)는 만들지 않고 [TBD: 출처 필요]로 표시"@ko ;
    wf:performedBy wf:agentTopicGenerator ;
    p-plan:hasInputVar wf:ApprovedDitaMap , wf:Spec , wf:Glossary ;
    p-plan:hasOutputVar wf:TopicDraft ;
    wf:usesResource wf:TopicTemplate , wf:DomainProfile ;
    wf:hasConstraint wf:c_NoProductSpecificInvention ;
    p-plan:isPrecededBy wf:step07 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:Glossary ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:DomainProfile ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:Spec ; wf:conditionalOn wf:SecurityClearance ] .

wf:step09 a wf:ReviewStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 9 ; rdfs:label "초안 검토·보완"@ko ;
    wf:task "생성된 초안을 대상 제품군에 맞게 수정·보완하고 [TBD] 항목을 채움"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:TopicDraft , wf:MergedChecklist ;
    p-plan:hasOutputVar wf:TopicReviewed ;
    p-plan:isPrecededBy wf:step08 ;
    wf:sendsToExternalLLM false .

wf:step10 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 10 ; rdfs:label "용어집 대비 용어 일치 검사"@ko ;
    wf:task "금지어 사용, 승인어 미사용, 표기 불일치를 규칙 매칭으로 검출"@ko ;
    wf:performedBy wf:scriptTermCheck ;
    p-plan:hasInputVar wf:TopicReviewed , wf:Glossary ;
    p-plan:hasOutputVar wf:TermCheckReport ;
    wf:usesResource wf:TermCheckScriptRes ;
    p-plan:isPrecededBy wf:step09 ;
    wf:sendsToExternalLLM false .

wf:step11 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 11 ; rdfs:label "XML 정형성 검증"@ko ;
    wf:task "XML 문법 오류 검출 (xmllint 또는 lxml)"@ko ;
    wf:performedBy wf:scriptWellFormed ;
    p-plan:hasInputVar wf:TopicForVerification , wf:ApprovedDitaMap ;
    p-plan:hasOutputVar wf:WellFormednessReport ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step10 ;
    wf:sendsToExternalLLM false .

wf:step12 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 12 ; rdfs:label "DITA 유효성 검증"@ko ;
    wf:task "DTD 기준 유효성 검사 (dita validate)"@ko ;
    wf:performedBy wf:scriptDitaValidate ;
    p-plan:hasInputVar wf:TopicForVerification , wf:ApprovedDitaMap , wf:DTD ;
    p-plan:hasOutputVar wf:ValidityReport ;
    wf:usesResource wf:SchemaTemplate ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step11 ;
    wf:sendsToExternalLLM false .

wf:step13 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 13 ; rdfs:label "DITA 규칙 검증"@ko ;
    wf:task "작성 규칙 검사 (Schematron 등). 판단이 필요한 규칙만 선택적으로 LLM 사용"@ko ;
    wf:performedBy wf:scriptRuleCheck ;
    wf:optionalLLMUse true ;
    p-plan:hasInputVar wf:TopicForVerification , wf:ApprovedDitaMap , wf:RuleList ;
    p-plan:hasOutputVar wf:RuleReport ;
    wf:usesResource wf:RuleList ;
    wf:hasConstraint wf:c_MaskedMetadataOnly ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step12 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:MaskedMetadata ; wf:conditionalOn wf:JudgmentRuleUsesLLM ] .

wf:step14 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 14 ; rdfs:label "DITA-OT 빌드, 로그 분류, 링크 검사"@ko ;
    wf:task "빌드 실행, 메시지 ID·심각도별 로그 분류, 내부 링크 오프라인 검사"@ko ;
    wf:performedBy wf:scriptBuild ;
    p-plan:hasInputVar wf:TopicForVerification , wf:ApprovedDitaMap ;
    p-plan:hasOutputVar wf:BuildLogReport , wf:LinkReport ;
    wf:usesResource wf:LogClassificationTable ;
    wf:hasConstraint wf:c_UrlAllowlist ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step13 ;
    wf:sendsToExternalLLM false .

wf:step15 a wf:ValidationStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 15 ; rdfs:label "내용 일관성 검증"@ko ;
    wf:task "근거 자료와 비교 가능한 항목만 검사: 사양서와 수치 일치, 최신 용어집 준수, 체크리스트 필수 항목, [TBD] 잔존. 기술적 정확성 판정은 범위 밖(16번 사람 판단). 8번과 다른 지시문으로 실행"@ko ;
    wf:performedBy wf:agentContentChecker , wf:scriptContentCheck ;
    p-plan:hasInputVar wf:TopicForVerification , wf:Spec , wf:CurrentGlossary ;
    p-plan:hasOutputVar wf:ContentReport ;
    wf:usesResource wf:VerificationChecklist , wf:DomainProfile ;
    wf:hasConstraint wf:c_EvidenceComparableOnly , wf:c_IndependentPrompt ;
    wf:mustUseDifferentPromptThan wf:step08 ;
    wf:outOfScopeDelegatedTo wf:step16 ;
    wf:alwaysExecutes true ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step14 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:TopicForVerification ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:DomainProfile ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:Spec ; wf:conditionalOn wf:SecurityClearance ] .

wf:step16 a wf:DecisionStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 16 ; rdfs:label "검증 결과 확인 및 실행 항목 판단"@ko ;
    wf:task "10번 용어 검사 리포트(1회차)와 11~15 리포트를 한 번에 검토. 기술적 정확성 판단, 수정 항목과 수정 내용 결정, 허용할 경고 지정, 필요 시 용어집 갱신. 수정 항목이 없으면 현재 검증 대상 토픽을 최종 토픽으로 확정. 반복 상한(3회) 도달 시 직접 수정 또는 예외 승인을 결정"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:TermCheckReport , wf:WellFormednessReport , wf:ValidityReport , wf:RuleReport ,
                       wf:BuildLogReport , wf:LinkReport , wf:ContentReport , wf:Diff ;
    p-plan:hasOutputVar wf:FixInstructions , wf:FinalTopic , wf:ExceptionApproval , wf:GlossaryUpdated ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step15 ;
    wf:sendsToExternalLLM false .

wf:step17 a wf:CorrectionStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 17 ; rdfs:label "오류 사항 수정 및 반영"@ko ;
    wf:task "기계적 수정(XML 오류, 용어 치환)은 자동 처리. 내용 수정은 16번 지시서에 적힌 내용만 반영. 용어 치환은 최신 용어집 기준. 변경 전후 비교(diff) 생성"@ko ;
    wf:performedBy wf:agentFixer , wf:scriptFixer ;
    p-plan:hasInputVar wf:TopicForVerification , wf:FixInstructions , wf:CurrentGlossary ;
    p-plan:hasOutputVar wf:TopicCorrected , wf:Diff ;
    wf:hasConstraint wf:c_InstructionOnlyFix ;
    p-plan:isPrecededBy wf:step16 ;
    wf:sendsToExternalLLM true ;
    wf:hasExternalTransmission [ a wf:ExternalTransmission ; wf:transmits wf:TopicForVerification ] ,
                               [ a wf:ExternalTransmission ; wf:transmits wf:FixInstructions ] .

wf:step18 a wf:PublishingStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 18 ; rdfs:label "PDF/HTML 변환"@ko ;
    wf:task "DITA-OT로 최종 출력물 생성"@ko ;
    wf:performedBy wf:scriptPublish ;
    p-plan:hasInputVar wf:FinalTopic , wf:ApprovedDitaMap ;
    p-plan:hasOutputVar wf:OutputPDF , wf:OutputHTML ;
    wf:usesResource wf:OutputPlugin ;
    p-plan:isPrecededBy wf:step16 ;
    wf:sendsToExternalLLM false .

wf:step19 a wf:ApprovalStep ; p-plan:isStepOfPlan wf:DitaDraftWorkflow ;
    wf:stepNumber 19 ; rdfs:label "최종 출력물 확인·승인"@ko ;
    wf:task "페이지 넘김, 표 넘침, 이미지 위치, 경고 표시 등 레이아웃을 확인하고 납품 승인. 예외 승인된 잔여 오류가 있으면 납품 가능 여부를 함께 확인"@ko ;
    wf:performedBy wf:Writer ;
    p-plan:hasInputVar wf:OutputPDF , wf:OutputHTML , wf:ExceptionApproval ;
    p-plan:hasOutputVar wf:ApprovedDeliverable ;
    wf:requiresExclusionReason true ;
    p-plan:isPrecededBy wf:step18 ;
    wf:sendsToExternalLLM false .

wf:End a wf:Terminal ; rdfs:label "종료"@ko .

# =====================================================================
#  PART 5. 전이 (엑셀 J열 '다음 단계·분기')
# =====================================================================

wf:t01_02 a wf:Transition ; wf:fromStep wf:step01 ; wf:toStep wf:step02 ; wf:onCondition wf:Always .
wf:t02_03 a wf:Transition ; wf:fromStep wf:step02 ; wf:toStep wf:step03 ; wf:onCondition wf:Always .
wf:t03_04 a wf:Transition ; wf:fromStep wf:step03 ; wf:toStep wf:step04 ; wf:onCondition wf:Approved .
wf:t04_05 a wf:Transition ; wf:fromStep wf:step04 ; wf:toStep wf:step05 ; wf:onCondition wf:NoViolations ;
    rdfs:comment "경고·정보는 진행을 막지 않고 리포트에만 기록"@ko .
wf:t04_03 a wf:Transition ; wf:fromStep wf:step04 ; wf:toStep wf:step03 ; wf:onCondition wf:ViolationsFound ;
    rdfs:comment "검증 리포트를 첨부해 사람이 단계 추가·제외를 다시 결정"@ko .
wf:t03_02 a wf:Transition ; wf:fromStep wf:step03 ; wf:toStep wf:step02 ; wf:onCondition wf:Rejected ;
    rdfs:comment "횟수 제한 없음 (사람이 판단)"@ko .
wf:t05_06 a wf:Transition ; wf:fromStep wf:step05 ; wf:toStep wf:step06 ; wf:onCondition wf:Always .
wf:t06_07 a wf:Transition ; wf:fromStep wf:step06 ; wf:toStep wf:step07 ; wf:onCondition wf:Always .
wf:t07_08 a wf:Transition ; wf:fromStep wf:step07 ; wf:toStep wf:step08 ; wf:onCondition wf:Approved .
wf:t07_06 a wf:Transition ; wf:fromStep wf:step07 ; wf:toStep wf:step06 ; wf:onCondition wf:Rejected ;
    rdfs:comment "횟수 제한 없음 (사람이 판단)"@ko .
wf:t08_09 a wf:Transition ; wf:fromStep wf:step08 ; wf:toStep wf:step09 ; wf:onCondition wf:Always .
wf:t09_10 a wf:Transition ; wf:fromStep wf:step09 ; wf:toStep wf:step10 ; wf:onCondition wf:Always .
wf:t10_11 a wf:Transition ; wf:fromStep wf:step10 ; wf:toStep wf:step11 ; wf:onCondition wf:Always .
wf:t11_12 a wf:Transition ; wf:fromStep wf:step11 ; wf:toStep wf:step12 ; wf:onCondition wf:Always .
wf:t12_13 a wf:Transition ; wf:fromStep wf:step12 ; wf:toStep wf:step13 ; wf:onCondition wf:Always .
wf:t13_14 a wf:Transition ; wf:fromStep wf:step13 ; wf:toStep wf:step14 ; wf:onCondition wf:Always .
wf:t14_15 a wf:Transition ; wf:fromStep wf:step14 ; wf:toStep wf:step15 ; wf:onCondition wf:Always .
wf:t15_16 a wf:Transition ; wf:fromStep wf:step15 ; wf:toStep wf:step16 ; wf:onCondition wf:Always .
wf:t16_17 a wf:Transition ; wf:fromStep wf:step16 ; wf:toStep wf:step17 ; wf:onCondition wf:HasFixItems .
wf:t16_18 a wf:Transition ; wf:fromStep wf:step16 ; wf:toStep wf:step18 ; wf:onCondition wf:NoFixItems ;
    rdfs:comment "현재 검증 대상 토픽을 최종 토픽으로 확정한 뒤 진행"@ko .
wf:t16_11 a wf:Transition ; wf:fromStep wf:step16 ; wf:toStep wf:step11 ; wf:onCondition wf:LimitReachedDirectFix ;
    wf:countsTowardIteration false ;
    rdfs:comment "작업자가 직접 수정한 뒤 11~15번 재검증. 자동 반복 횟수에 포함하지 않음 (사람 판단)"@ko .
wf:t16_18x a wf:Transition ; wf:fromStep wf:step16 ; wf:toStep wf:step18 ; wf:onCondition wf:ExceptionApproved ;
    rdfs:comment "예외 승인 기록을 남기고 현재 토픽을 최종 토픽으로 확정"@ko .
wf:t17_11 a wf:Transition ; wf:fromStep wf:step17 ; wf:toStep wf:step11 ; wf:onCondition wf:Always ;
    wf:countsTowardIteration true ; wf:governedBy wf:FixReverifyLoop .
wf:t18_19 a wf:Transition ; wf:fromStep wf:step18 ; wf:toStep wf:step19 ; wf:onCondition wf:Always .
wf:t19_end a wf:Transition ; wf:fromStep wf:step19 ; wf:toStep wf:End ; wf:onCondition wf:Approved .
wf:t19_18 a wf:Transition ; wf:fromStep wf:step19 ; wf:toStep wf:step18 ; wf:onCondition wf:LayoutIssue ;
    wf:countsTowardIteration false .
wf:t19_16 a wf:Transition ; wf:fromStep wf:step19 ; wf:toStep wf:step16 ; wf:onCondition wf:ContentIssue ;
    wf:countsTowardIteration true ; wf:governedBy wf:FixReverifyLoop ;
    rdfs:comment "반복 횟수가 이미 3회면 16번에서 상한 도달 처리(직접 수정 또는 예외 승인)"@ko .

# =====================================================================
#  PART 6. 반복·생략 규칙 ('반복·분기 규칙' 시트)
# =====================================================================

wf:FixReverifyLoop a wf:IterationRule ; rdfs:label "수정–재검증 반복"@ko ;
    rdfs:comment "반복 1회 = 17번 수정 → 11~15번 재검증 → 16번 확인"@ko ;
    wf:loopBody wf:step17 , wf:step11 , wf:step12 , wf:step13 , wf:step14 , wf:step15 , wf:step16 ;
    wf:maxIterations 3 ;
    wf:exitOnPassTo wf:step16 ;
    wf:passRule "재검증 결과 오류 0건이어도 16번에서 최종 토픽을 확정한 뒤 18번으로 진행 (v2의 '오류 0건 → 18번 직행'과 '모든 결과는 16번으로 모음'의 불일치를 해소)"@ko ;
    wf:onErrorsRemainTo wf:step16 ;
    wf:errorCountingRule "16번에서 허용한 경고는 오류로 세지 않음"@ko ;
    wf:onLimitReached "3회째 재검증 후에도 오류가 남으면 자동 반복을 멈추고 16번에서 판단: 작업자 직접 수정 후 11번 재검증(자동 반복 횟수 미포함), 또는 예외 승인 후 최종 토픽 확정 → 18번"@ko ;
    wf:justifiedBy wf:Decision3 , wf:Decision12 ;
    rdfs:comment "용어 준수는 15번 내용 검증에서만 확인하며, 10번 용어 검사는 반복 구간에 넣지 않음 (결정 12). 10번 리포트는 16번에서 다른 리포트와 함께 사람이 검토 (결정 13)"@ko .

wf:skipAfterWellFormedFail a wf:SkipRule ; rdfs:label "정형성 실패 파일 생략"@ko ;
    wf:triggeredByFailureOf wf:step11 ; wf:skips wf:step12 , wf:step13 ; wf:scope "파일 단위"@ko ;
    wf:reason "빌드 실패와 무의미한 리포트 방지"@ko .
wf:skipBuildOnFail a wf:SkipRule ; rdfs:label "정형성·유효성 실패 시 빌드 생략"@ko ;
    wf:triggeredByFailureOf wf:step11 , wf:step12 ; wf:skips wf:step14 ; wf:scope "전체 빌드"@ko ;
    wf:reason "빌드 실패와 무의미한 리포트 방지"@ko .

# =====================================================================
#  PART 7. 제약
# =====================================================================

wf:c_CompetitorStructureOnly a wf:ScopeConstraint ;
    rdfs:label "타사 매뉴얼은 목차 구조 참고용으로 제한"@ko .
wf:c_SecurityLevel a wf:SecurityConstraint ;
    rdfs:label "보안 등급에 따라 사양서의 LLM 입력 여부 결정"@ko .
wf:c_NoProductSpecificInvention a wf:ScopeConstraint ;
    rdfs:label "제품 고유 정보 생성 금지"@ko ;
    wf:prohibits "사양서에 없는 세부 절차, UI 명칭, 수치, 안전 메시지"@ko ;
    wf:placeholderMarker "[TBD: 출처 필요]" .
wf:c_MaskedMetadataOnly a wf:SecurityConstraint ;
    rdfs:label "판단형 규칙에 LLM 사용 시 마스킹된 메타데이터만 전송"@ko .
wf:c_UrlAllowlist a wf:SecurityConstraint ;
    rdfs:label "외부 URL 검사는 허용 목록만"@ko .
wf:c_EvidenceComparableOnly a wf:ScopeConstraint ;
    rdfs:label "근거 자료와 비교 가능한 항목만 검사 (기술적 정확성 판정은 16번)"@ko .
wf:c_IndependentPrompt a wf:IndependenceConstraint ;
    rdfs:label "8번(생성)과 다른 지시문으로 실행"@ko .
wf:c_InstructionOnlyFix a wf:ScopeConstraint ;
    rdfs:label "내용 수정은 16번 지시서에 적힌 내용만 반영"@ko .

# =====================================================================
#  PART 8. 결정 사항과 변경 이력 ('변경 이력' 시트)
#  원안→v2 기록의 변경 내용 문장에 나오는 단계 번호는 v2 기준입니다. resultingStep은 v3 단계를 가리킵니다.
# =====================================================================

wf:Decision1 a wf:Decision ; rdfs:label "결정 사항 1: 검증 결과 사람 확인을 하나의 단계로 통합"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-21~22" .
wf:Decision2 a wf:Decision ; rdfs:label "결정 사항 2: 워크플로우 추출은 LLM 제안 + 사람 승인"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-21~22" .
wf:Decision3 a wf:Decision ; rdfs:label "결정 사항 3: 수정–재검증 반복 최대 3회"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-21~22" .
wf:Decision4 a wf:Decision ; rdfs:label "결정 사항 4: 사용자·설치·서비스·운영·유지보수 매뉴얼을 별개 종류로 산정 (목차 기본 템플릿·체크리스트 종류별 작성)"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision5 a wf:Decision ; rdfs:label "결정 사항 5: 1번 입력 '일반 매뉴얼 템플릿' 삭제, 6번에서 매뉴얼 종류별 목차 기본 템플릿 사용"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision6 a wf:Decision ; rdfs:label "결정 사항 6: HTML 출력 설정(T24) 우선순위 B 유지 — 확정 콘텐츠에 형식을 입히고 레이아웃을 검수하는 단계"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision7 a wf:Decision ; rdfs:label "결정 사항 7: 프로젝트 정의서(T01)에 project-profile.yaml 통합 — 단일 프로젝트 파일"@ko ; wf:decidedBy "Claude 검토 (사용자 위임)" ; wf:decidedOn "2026-10-29" .
wf:Decision9 a wf:Decision ; rdfs:label "결정 사항 9: 유지보수 매뉴얼 우선순위는 서비스 매뉴얼과 같은 B로 확정"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision10 a wf:Decision ; rdfs:label "결정 사항 10: 통합 매뉴얼은 매뉴얼 종류 목록(1개 이상)으로 표현하고 새 종류를 만들지 않음. 목차·체크리스트는 종류 태그를 단 라이브러리 1개씩으로 관리하고 6번 스크립트가 병합 (테스트하며 수정)"@ko ; wf:decidedBy "Claude 제안, 사용자 확정" ; wf:decidedOn "2026-10-29" .
wf:Decision11 a wf:Decision ; rdfs:label "결정 사항 11: 분야 프로필(domain profile)과 목차 분야 덧붙임(T07)을 분야별 파일 1개로 통합 (매뉴얼 종류별 덧붙임 포함)"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision12 a wf:Decision ; rdfs:label "결정 사항 12: 용어 준수는 15번 내용 검증에서만 확인 — 수정–재검증 반복 구간(17 → 11~15)에 10번 용어 검사를 넣지 않음 (번호는 결정 13 반영 후 기준)"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision13 a wf:Decision ; rdfs:label "결정 사항 13: 10번 용어 검사(스크립트)는 유지하고, 사람의 용어 검사 결과 검토(v3 초안 11번)는 16번 검증 결과 확인에 통합. 단계 20개 → 19개"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .
wf:Decision14 a wf:Decision ; rdfs:label "결정 사항 14: @locktitle 정책 D2′ — 맵에 @locktitle을 쓰지 않고, 8번 스크립트가 토픽 title을 승인된 맵의 navtitle로 채우며, 13번 규칙(R13-001)이 맵 navtitle과 토픽 title의 일치를 검사"@ko ; wf:decidedBy "Claude 제안, 사용자 확정" ; wf:decidedOn "2026-11-04" .
wf:Decision15 a wf:Decision ; rdfs:label "결정 사항 15: 13번 DITA 규칙 검증의 입력에 승인된 DITA map 추가"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-11-04" .
wf:Decision8 a wf:Decision ; rdfs:label "결정 사항 8: A 등급 템플릿 작성 순서 T28·T30·T32 → T36 → T10·T20, 이후 실제 데이터 테스트로 보정"@ko ; wf:decidedBy "사용자" ; wf:decidedOn "2026-10-29" .

